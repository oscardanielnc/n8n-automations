# Copy to ~/n8n/.env ON THE VM and fill it in there. Never commit the real .env.
N8N_VERSION=          # pinned stable version (e.g. 2.x.y), see https://docs.n8n.io/release-notes/
N8N_HOST=n8n.example.com
N8N_ENCRYPTION_KEY=   # openssl rand -hex 32  (lose it and stored credentials can no longer be decrypted)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=    # openssl rand -hex 24
POSTGRES_DB=n8n
