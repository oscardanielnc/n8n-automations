              "name": "includeSpamTrash",
              "value": "true"
            }
          ]
        },
        "options": {
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "pageToken",
                    "value": "={{ $response.body.nextPageToken }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.nextPageToken }}",
              "limitPagesFetched": true,
              "maxRequests": 20
            }
          }
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "gmailPersonal001",
          "name": "Gmail - personal"
        }
      },
      "executeOnce": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "d3b3c0de-0104-4000-8000-000000000004",
      "name": "Group ids personal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Gmail accepts up to 1000 ids per batchModify call.\nconst ids = $input.all().flatMap(it => (it.json.messages || []).map(m => m.id));\nconst out = [];\nfor (let i = 0; i < ids.length; i += 1000) out.push({ json: { ids: ids.slice(i, i + 1000) } });\nreturn out.length ? out : [{ json: { ids: [] } }];"
      }
    },
    {
      "id": "d3b3c0de-0105-4000-8000-000000000005",
      "name": "Move to Trash personal",
      "type": "n8n-nodes-base.httpRequest",
