        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ids: $json.ids, addLabelIds: ['TRASH'] }) }}",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "gmailPersonal001",
          "name": "Gmail - personal"
