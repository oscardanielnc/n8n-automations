    {
      "id": "d3b3c0de-0303-4000-8000-000000000033",
      "name": "List old Outlook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        540
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://graph.microsoft.com/v1.0/me/messages?$select=id&$top=1000&$filter=receivedDateTime%20lt%20{{ $now.minus({ years: 1 }).toUTC().toFormat(\"yyyy-MM-dd'T'HH:mm:ss'Z'\") }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {
          "pagination": {
            "pagination": {
              "paginationMode": "responseContainsNextURL",
              "nextURL": "={{ $response.body['@odata.nextLink'] }}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body['@odata.nextLink'] }}",
              "limitPagesFetched": true,
              "maxRequests": 10
            }
          }
        }
      },
      "credentials": {
        "oAuth2Api": {
          "id": "outlookCred00001",
          "name": "Outlook"
        }
      },
      "executeOnce": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "d3b3c0de-0304-4000-8000-000000000034",
      "name": "Group ids Outlook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        540
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Graph has no bulk move: one JSON $batch call carries up to 20 \"move\" requests.\nconst ids = $input.all().flatMap(it => (it.json.value || []).map(m => m.id));\nconst out = [];\nfor (let i = 0; i < ids.length; i += 20) {\n  const chunk = ids.slice(i, i + 20);\n  out.push({ json: { ids: chunk, body: { requests: chunk.map((id, k) => ({\n    id: String(k + 1), method: 'POST', url: `/me/messages/${id}/move`,\n    headers: { 'Content-Type': 'application/json' }, body: { destinationId: 'deleteditems' } })) } } });\n}\nreturn out.length ? out : [{ json: { ids: [] } }];"
      }
    },
    {
      "id": "d3b3c0de-0305-4000-8000-000000000035",
      "name": "Move to Deleted Outlook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        540
      ],
      "parameters": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/$batch",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1500
            }
          }
        }
      },
      "credentials": {
        "oAuth2Api": {
          "id": "outlookCred00001",
          "name": "Outlook"
        }
      },
      "disabled": false,
      "onError": "continueRegularOutput"
    },
    {
      "id": "d3b3c0de-0006-4000-8000-000000000006",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const ACCOUNTS = [[\"personal\", \"📧 Gmail personal\"], [\"work\", \"🎓 Work\"]];\nconst dry = false;\nconst outlookLive = true;\nconst lines = [dry ? '🧹 <b>Limpieza de correo (prueba: no se borró nada)</b>' : '🧹 <b>Limpieza de correo</b>'];\nfor (const [name, label] of ACCOUNTS) {\n  let total = 0, pages = 0;\n  try { total = $(`Group ids ${name}`).all().reduce((n, it) => n + it.json.ids.length, 0); } catch (e) {}\n  try { pages = $(`List old ${name}`).all().length; } catch (e) {}\n  lines.push(`${label}: ${total} correos de más de 1 año ${dry ? 'encontrados' : '→ papelera'}${pages >= 20 ? ' (quedan más: siguen el próximo mes)' : ''}`);\n}\nlet ol = 0;\ntry { ol = $('Group ids Outlook').all().reduce((n, it) => n + (it.json.ids || []).length, 0); } catch (e) {}\nconst olMore = ol >= 10000 ? ' (quedan más: siguen el próximo mes)' : '';\nif (dry || !outlookLive) lines.push(`📨 Outlook: ${ol} correos de más de 1 año encontrados${olMore}${!dry && !outlookLive ? ' — <i>no se tocan hasta tu OK</i>' : ''}`);\nelse lines.push(`📨 Outlook: ${ol} correos de más de 1 año → Elementos eliminados${olMore}`);\nif (!dry) lines.push('Gmail los borra solo en 30 días (hasta entonces se pueden recuperar).');\nreturn [{ json: { text: lines.join('\\n') } }];"
      }
    },
    {
      "id": "d3b3c0de-0007-4000-8000-000000000007",
