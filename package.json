{
  "name": "n8n-automations",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint apps/api/src apps/web/src packages/ui/src packages/contracts/src",
    "typecheck": "turbo run typecheck",
    "storybook": "pnpm --filter @panel/ui storybook",
    "check:unicode": "node scripts/check-unicode.mjs --all",
    "demo": "node scripts/demo/run.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
