# Copy to deploy/.env on the VM (chmod 600). Never commit the real file.
NODE_ENV=production
N8N_API_URL=http://n8n:5678/api/v1
# n8n > Settings > n8n API > Create an API key (loaded with scripts/set-n8n-api-key.ps1, never typed here)
N8N_API_KEY=
N8N_PUBLIC_URL=https://n8n.example.com
SHARED_DIR=/data/shared
# Cloudflare Zero Trust > Access > Applications > n8n panel: team domain and Application Audience (AUD) tag
ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
ACCESS_AUD=
